# Sierra Leone AI Foundation – environment template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# HuggingFace token (also accepted as SLAI_HF_TOKEN).
# Used only for private model/dataset access. Leave empty if not needed.
HF_TOKEN=

# Project paths (defaults are relative to repo root)
SLAI_DATA_DIR=datasets
SLAI_MODELS_DIR=models
SLAI_LOGS_DIR=logs

# API server
SLAI_API_HOST=0.0.0.0
SLAI_API_PORT=8000
SLAI_API_DEBUG=false

# Safety
SLAI_ALLOW_TRAINING=false   # set true only on a machine with verified GPU resources
