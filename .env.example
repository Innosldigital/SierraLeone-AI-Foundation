# Sierra Leone AI Foundation – environment template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# HuggingFace token (also accepted as SLAI_HF_TOKEN).
# Used only for private model/dataset access. Leave empty if not needed.
HF_TOKEN=

# Project paths (anchored to package root by default; override only with an absolute path)
# SLAI_DATA_DIR=/absolute/path/to/datasets
# SLAI_MODELS_DIR=/absolute/path/to/models
# SLAI_LOGS_DIR=/absolute/path/to/logs

# API server
SLAI_API_HOST=127.0.0.1
SLAI_API_PORT=8000
SLAI_API_DEBUG=false
# CORS origins: JSON list of allowed origins. Empty [] disables CORS.
SLAI_CORS_ORIGINS=[]
# Maximum audio upload size in bytes (default 10 MB = 10485760 bytes)
SLAI_MAX_AUDIO_UPLOAD_BYTES=10485760

# Safety
SLAI_ALLOW_TRAINING=false   # set true only on a machine with verified GPU resources
